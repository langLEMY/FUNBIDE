# Variables para docker-compose.local.yml (Auth:Provider=Local, sin Supabase).
# Copiar este archivo como ".env.local" y completar los CHANGE_ME. ".env.local" nunca
# se commitea (ver .gitignore) — cada instalación genera sus propias claves.
#
# Para generar una clave/contraseña (Linux/macOS):
#   openssl rand -base64 32
# En Windows (PowerShell, funciona en 5.1 y en 7):
#   powershell -Command "$b=New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)"

FUNBIDE_DB_PASSWORD=CHANGE_ME
FUNBIDE_JWT_SIGNING_KEY=CHANGE_ME_GENERAR_32_BYTES_EN_BASE64
FUNBIDE_STORAGE_SIGNING_KEY=CHANGE_ME_GENERAR_OTROS_32_BYTES_EN_BASE64

# Puerto donde queda expuesto FUNBIDE en el host (http://localhost:PUERTO). Opcional,
# por defecto 8080.
FUNBIDE_PUERTO=8080

{
  "_LEEME": "Plantilla para la instalación offline/USB (Auth:Provider=Local). Copiar este archivo como 'appsettings.Local.json' junto al ejecutable publicado y completar los CHANGE_ME. 'appsettings.Local.json' está en .gitignore: nunca se commitea con valores reales. Para generar una clave (funciona en Windows PowerShell 5.1 y en PowerShell 7): powershell -Command \"$b=New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)\"",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "FunbideDatabase": "Host=localhost;Port=5432;Database=funbide;Username=funbide;Password=CHANGE_ME;SSL Mode=Disable"
  },

  "Auth": {
    "Provider": "Local",
    "Local": {
      "SigningKeyBase64": "CHANGE_ME_GENERAR_32_BYTES_EN_BASE64",
      "DuracionToken": "12:00:00"
    }
  },

  "Storage": {
    "Local": {
      "DirectorioBase": "almacenamiento-local",
      "FirmaKeyBase64": "CHANGE_ME_GENERAR_OTROS_32_BYTES_EN_BASE64"
    }
  },

  "Backup": {
    "Habilitado": false
  },

  "Cors": {
    "OrigenesPermitidos": []
  }
}

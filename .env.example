# Usa el host del connection pooler (Supavisor) de Supabase, no "db.<proyecto>.supabase.co":
# ese host directo solo resuelve por IPv6, y muchas redes/servidores no lo tienen. El pooler
# además exige que el usuario incluya el ref del proyecto ("postgres.<ref>"), no "postgres" a secas.
FUNBIDE_DB_CONNECTION_STRING=Host=aws-0-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.CHANGE_ME;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
FUNBIDE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
FUNBIDE_DB_NAME=postgres
FUNBIDE_DB_USER=postgres.CHANGE_ME
FUNBIDE_DB_PASSWORD=CHANGE_ME

SUPABASE_PROJECT_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# openssl rand -base64 32
FUNBIDE_BACKUP_AES_KEY=CHANGE_ME_32_BYTES_BASE64

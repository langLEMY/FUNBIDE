bin/
obj/
.vs/
.vscode/
*.user
appsettings.*.local.json
# Contiene la cadena de conexión real y claves de Supabase para desarrollo local
# y para las copias de escritorio distribuidas al equipo — nunca secretos reales
# en git, solo appsettings.json (con placeholders) queda commiteado.
src/FUNBIDE.API/appsettings.Development.json

# Configuración real de la instalación offline/USB (Auth:Provider=Local) — se genera a
# partir de appsettings.Local.json.example en cada instalación, nunca se commitea.
src/FUNBIDE.API/appsettings.Local.json

# Frontend
node_modules/
dist/
dist-ssr/
*.local

# El build del frontend se genera dentro de la imagen Docker (ver el stage
# frontend-build del Dockerfile) — no debe vivir en git.
src/FUNBIDE.API/wwwroot/

# Secretos y entornos locales — nunca se comitean, solo los .example
.env
.env.*
!.env.example
# Sin secretos (solo VITE_AUTH_MODE/VITE_API_BASE_URL): se commitea para el build offline.
!.env.offline
# Sin secretos (placeholders CHANGE_ME): se commitea como plantilla de docker-compose.local.yml.
!.env.local.example
# La URL y la anon key de Supabase NO son secretas (se embeben en el bundle del
# cliente igual; la seguridad real es Row Level Security del lado de Supabase, no
# ocultar esto) — se commitea para que "npm run build" (modo real) funcione desde
# un clon nuevo del repo sin configuración manual previa.
!.env.production

# Configuración local del usuario de Claude Code (no es del equipo)
.claude/settings.local.json

# Acceso directo de Windows: formato binario atado a rutas absolutas de esta
# máquina, no portable. Se recrea apuntando a FUNBIDE.exe (ver launcher/).
*.lnk

# Archivos de trabajo temporales de sesiones de desarrollo
*.tmp
*.tmp.json
.api-run.log
.api-dev*.log
.api-dev.pid
.frontend-dev*.log
.frontend-dev.pid
.publish-run*.log
.publish-run.pid

# Salida de "dotnet publish" usada por el lanzador local de Windows
publish/

# Build publicado del launcher de escritorio (launcher/) — binario grande
# atado a esta máquina, se regenera con "dotnet publish launcher -c Release -o .".
# Los .xml son documentación de paquetes NuGet (p. ej. WebView2) que "dotnet
# publish -o ." copia sueltos a la raíz junto al exe.
/FUNBIDE.exe
/FUNBIDE.pdb
/*.xml

# Paquete offline/USB generado por scripts/publicar-offline.ps1 — binarios grandes
# autocontenidos, se regeneran corriendo el script, nunca se commitean.
/dist-offline/
/dist-offline.zip

# Paquete portable (FUNBIDE.exe + publish\, sin instalador) generado por
# scripts/publicar-portable.ps1 — lleva la contraseña real de Supabase adentro,
# nunca va a git.
/dist-portable/
/dist-portable.zip

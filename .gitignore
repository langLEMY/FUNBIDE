bin/
obj/
.vs/
.vscode/
*.user
appsettings.*.local.json

# Frontend
node_modules/
dist/
dist-ssr/
*.local

# El build del frontend se genera dentro de la imagen Docker (ver el stage
# frontend-build del Dockerfile) — no debe vivir en git.
src/FUNBIDE.API/wwwroot/

# Secretos y entornos locales — nunca se comitean, solo los .example
.env
.env.*
!.env.example

# Configuración local del usuario de Claude Code (no es del equipo)
.claude/settings.local.json

# Acceso directo de Windows: formato binario atado a rutas absolutas de esta
# máquina, no portable. El script Iniciar-FUNBIDE.ps1 que sí abre sí se comitea
# (usa $PSScriptRoot, portable).
*.lnk

# Archivos de trabajo temporales de sesiones de desarrollo
*.tmp
*.tmp.json
.api-run.log
.api-dev*.log
.api-dev.pid
.frontend-dev*.log
.frontend-dev.pid

# Salida de "dotnet publish" usada por el lanzador local de Windows
publish/
